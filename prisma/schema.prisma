enum DegreeType {
  Associates
  Bachelors
  Masters
  Doctorate
  License
  Certificate
  Permit
  Registration
}

enum AdditionalLinksType {
  article
  audio
  video
  website
  file
}

enum BusinessGoalsStatus {
  Active
  Achieved
}

enum BusinessNeedsStatus {
  Active
  Filled
}

enum ServiceTypes {
  featured
  main
}

enum PortfolioTemplateIdentification {
  DEFAULT
}

enum TwoFactorAuthType {
  none
  email
  phone
}

enum LinkType {
  requested
  accepted
  declined
  blocked
  muted
  archived
}

enum NotificationStatus {
  active
  archived
}

enum NotificationDirectsTo {
  linkRequest
  message
  contactRequest
  sharedContact
  sharedCard
}

enum ContactStatus {
  requested
  archived
  saved
}

enum ProfileLayout {
  minimal
  premium
}

enum GroupStatus {
  active
  muted
  archived
}

enum ConnectionViaPersonFilters {
  auto
  manual
}

enum DesignationType {
  receivedAt
  receivedFrom
}

enum ProfileType {
  user
  contact
}
