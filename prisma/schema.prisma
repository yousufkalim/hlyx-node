generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["filteredRelationCount"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAuth {
  email            String            @unique
  password         String?
  isEmailVerified  Boolean           @default(false)
  isPhoneVerified  Boolean           @default(false)
  role             Role              @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isDeleted        Boolean           @default(false)
  isPaused         Boolean           @default(false)
  passwordReset    DateTime?
  id               String            @id @default(uuid())
  userBio          UserBio?
  userNotification UserNotification?
  userPreference   UserPreferences?

  @@unique([id, email])
}

model UserBio {
  id                   String      @id
  User                 UserAuth    @relation(fields: [id, email], references: [id, email], onDelete: Cascade, onUpdate: Cascade)
  profileAvatar        String      @default("https://hlyx-dev-s3-bucket.s3.us-west-1.amazonaws.com/user-avatar.png")
  isOnBoardingComplete Boolean     @default(false)
  profileType          ProfileType @default(user)
  // Personal Info
  firstName            String?
  middleInitial        String?
  lastName             String?
  company              String?
  profTitle            String?
  industry             String?
  country              String?
  city                 String?
  state                String?
  zipcode              String?
  updatedAt            DateTime    @updatedAt
  email                String
  phone                String?     @unique
  website              String?
  profRole             String?

  userName      String?         @unique
  blockedUserId String?
  cards         Card[]
  Group         Group[]
  GroupMessages GroupMessages[]
  groups        GroupsOnUsers[]
  blockedUser   UserBio?        @relation("BlockedUsers", fields: [blockedUserId], references: [id])
  blockedUsers  UserBio[]       @relation("BlockedUsers")
  profilePhotos UserPhoto[]

  @@unique([id, email])
  @@unique([id, profileAvatar])
}

model Group {
  id            String          @id @default(uuid())
  description   String?
  tags          String[]
  isPrivate     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  groupPhoto    String?
  groupName     String          @unique
  adminUser     String
  isArchived    Boolean         @default(false)
  isMuted       Boolean         @default(false)
  GroupAdmin    UserBio         @relation(fields: [adminUser], references: [id])
  GroupMessages GroupMessages[]
  members       GroupsOnUsers[]
}

model GroupsOnUsers {
  userId    String
  groupId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Group     Group    @relation(fields: [groupId], references: [id])
  User      UserBio  @relation(fields: [userId], references: [id])

  @@id([userId, groupId])
}

model GroupMessages {
  id        String   @id @default(uuid())
  message   String
  senderId  String
  groupId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Group     Group    @relation(fields: [groupId], references: [id])
  sender    UserBio  @relation(fields: [senderId], references: [id])
}

model UserPreferences {
  id                       String                      @id @default(uuid())
  twoFactorAuth            TwoFactorAuthType           @default(none)
  allCardsPrivate          Boolean                     @default(false)
  connectionViaProfileLink Boolean                     @default(false)
  connectionViaQRCode      Boolean                     @default(false)
  connectionViaPerson      Boolean                     @default(false)
  userId                   String                      @unique
  connectionViaContacts    Boolean                     @default(false)
  personFilter             ConnectionViaPersonFilters?
  User                     UserAuth                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotification {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  newLinkRequest         Boolean  @default(false)
  newMessage             Boolean  @default(false)
  groupMessages          Boolean  @default(false)
  profileShare           Boolean  @default(false)
  acceptedLinkRequest    Boolean  @default(false)
  accountSecurity        Boolean  @default(false)
  newContactRequest      Boolean  @default(false)
  newContactRequestPhone Boolean  @default(false)
  User                   UserAuth @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPhoto {
  userId     String
  pathToFile String
  User       UserBio @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, pathToFile])
}

model Card {
  userId            String
  userAvatar        String
  coverPhoto        String?
  fullName          String
  cardName          String
  profileLayout     ProfileLayout
  isPrivate         Boolean                         @default(false)
  activeCard        Boolean                         @default(true)
  // Contact Page
  headerPhoto       String?
  city              String
  state             String?
  country           String?
  emails            CardEmails[]
  phones            CardPhones[]
  websites          CardWebsites[]
  socialMedias      CardSocialMedias[]
  calendars         CardCalendars[]
  officeAddresses   CardOfficeAddresses[]
  additionalLinks   CardAdditionalLinks[]
  // About Page
  about             String?
  company           String?
  profTitle         String?
  occupation        String?
  industry          String?
  hobbies           String[]
  interests         String[]
  skills            String[]
  motto             String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  streetAddress     String?
  zipcode           String?
  publicCard        Boolean                         @default(true)
  companyIcon       String?
  portfolioTemplate PortfolioTemplateIdentification @default(DEFAULT)
  cardId            String                          @id @default(uuid())
  templateId        TemplateIdentification          @default(DEFAULT)
  slug              String?                         @unique
  brandedCoverPhoto String?
  qrCodeImage       String?                         @unique
  User              UserBio                         @relation(fields: [userId, userAvatar], references: [id, profileAvatar], onDelete: Cascade)
  accolades         CardAccolades[]
  achievements      CardAchievements[]
  businessGoals     CardBusinessGoals[]
  businessNeeds     CardBusinessNeeds[]
  companyIcons      CardCompanyIcons[]
  coverPhotos       CardCoverPhotos[]
  education         CardEducations[]
  portfolio         CardPortfolio[]
  portfolioImages   CardPortfolioImages[]
  services          CardServices[]
  Contacts          Contact[]
  Links             Link[]                          @relation("CardOneRef")
  LinksDuplicate    Link[]                          @relation("CardTwoRef")
  LinkPhoto         LinkPhoto[]
  Notifications     Notification[]
}

model CardCoverPhotos {
  cardId     String
  pathToFile String
  Card       Card   @relation(fields: [cardId], references: [cardId], onDelete: Cascade)

  @@id([cardId, pathToFile])
}

model CardCompanyIcons {
  cardId     String
  pathToFile String
  Card       Card   @relation(fields: [cardId], references: [cardId], onDelete: Cascade)

  @@id([cardId, pathToFile])
}

model CardEmails {
  id     String  @id @default(uuid())
  email  String
  cardId String
  type   String?
  Card   Card    @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardPhones {
  id        String    @id @default(uuid())
  phone     String
  extention String?
  type      PhoneType
  cardId    String
  Card      Card      @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardWebsites {
  id          String  @id @default(uuid())
  description String?
  cardId      String
  url         String
  Card        Card    @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardSocialMedias {
  id         String  @id @default(uuid())
  platform   String
  handle     String?
  cardId     String
  label      String?
  profileUrl String
  Card       Card    @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardAdditionalLinks {
  id          String              @id @default(uuid())
  title       String
  description String?
  cardId      String
  url         String
  typeContent AdditionalLinksType
  Card        Card                @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardEducations {
  id            String      @id @default(uuid())
  academicLevel String
  schoolName    String
  academicFocus String
  cardId        String
  endDate       DateTime?
  startDate     DateTime
  licenseNumber Int?
  degreeType    DegreeType?
  Card          Card        @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardAccolades {
  id              String          @id @default(uuid())
  title           String
  startDate       DateTime
  endDate         DateTime?
  cardId          String
  designationType DesignationType
  organization    String?
  Card            Card            @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardAchievements {
  id          String    @id @default(uuid())
  title       String
  cardId      String
  description String
  endDate     DateTime?
  startDate   DateTime
  Card        Card      @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardBusinessGoals {
  id              String              @id @default(uuid())
  status          BusinessGoalsStatus
  title           String
  percentComplete Int                 @default(0)
  startDate       DateTime            @default(now())
  endDate         DateTime?
  cardId          String
  description     String
  Card            Card                @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardBusinessNeeds {
  id          String              @id @default(uuid())
  title       String
  status      BusinessNeedsStatus
  cardId      String
  description String?
  endDate     DateTime?
  startDate   DateTime
  Card        Card                @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardServices {
  id          String       @id @default(uuid())
  title       String
  details     String?
  cardId      String
  type        ServiceTypes
  subtitle    String?
  positioning Int
  url         String[]
  Card        Card         @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardPortfolio {
  id          String @id @default(uuid())
  cardId      String
  title       String
  details     String
  positioning Int
  image       String
  Card        Card   @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardPortfolioImages {
  cardId     String
  pathToFile String
  Card       Card   @relation(fields: [cardId], references: [cardId], onDelete: Cascade)

  @@id([cardId, pathToFile])
}

model CardCalendars {
  id     String  @id @default(uuid())
  cardId String
  label  String?
  title  String
  url    String
  Card   Card    @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model CardOfficeAddresses {
  id            String  @id @default(uuid())
  cardId        String
  label         String?
  streetAddress String
  city          String
  state         String?
  zipcode       String?
  Card          Card    @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model Link {
  cardOne         String
  cardTwo         String
  status          LinkType
  recentChangeBy  String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  linkedAt        DateTime?
  id              String         @id @default(uuid())
  bothUserBlock   Boolean        @default(false)
  cardOneFavorite Boolean        @default(false)
  cardTwoFavorite Boolean        @default(false)
  bothUserMute    Boolean        @default(false)
  event           String?
  metAt           String?
  CardOneRef      Card           @relation("CardOneRef", fields: [cardOne], references: [cardId], onDelete: Cascade)
  CardTwoRef      Card           @relation("CardTwoRef", fields: [cardTwo], references: [cardId], onDelete: Cascade)
  messages        LinkMessages[]
  notes           LinkNotes[]
  photos          LinkPhoto[]

  @@unique([cardOne, cardTwo])
  @@unique([id, cardOne, cardTwo])
}

model LinkNotes {
  id          String   @id @default(uuid())
  linkId      String
  recipientId String
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String
  Link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model LinkMessages {
  id          String   @id @default(uuid())
  linkId      String
  senderId    String
  recipientId String
  message     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model LinkPhoto {
  linkId     String
  pathToFile String
  cardId     String
  Card       Card   @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
  Link       Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, pathToFile])
}

model Contact {
  contactId    String        @id @default(uuid())
  cardId       String
  contactImage String?
  status       ContactStatus @default(requested)
  fullName     String
  company      String?
  jobTitle     String?
  phone        String        @unique
  email        String        @unique
  message      String?
  notes        String?
  createdAt    DateTime      @default(now())
  city         String?
  state        String?
  updatedAt    DateTime      @updatedAt
  event        String?
  metAt        String?
  Card         Card          @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

model Notification {
  notificationId String                @id @default(uuid())
  cardId         String
  status         NotificationStatus    @default(active)
  updatedAt      DateTime              @updatedAt
  directsTo      NotificationDirectsTo
  message        String?
  idDirectedTo   String?
  sharedBy       String?
  Card           Card                  @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  USER
  COMPANY
}

enum TemplateIdentification {
  DEFAULT
  FULL
}

enum EmailType {
  work
  personal
  alternate
}

enum PhoneType {
  home
  work
  mobile
  main
  fax
  direct
  office
}

